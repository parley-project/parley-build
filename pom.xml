<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator for building everything in the Parley family with one command. It lists only
  projects that are git repositories.

    mvn -f parley-build/pom.xml verify

  The modules are listed in dependency order, for reading; Maven sorts them by their
  dependencies anyway.
  Useful variations:

    mvn -f parley-build/pom.xml install -DskipTests      build and install all to ~/.m2
    mvn -f parley-build/pom.xml verify -pl parley-files-fx -am   one module plus what it needs
    mvn -f parley-build/pom.xml verify -rf :parley-net   resume after a failure

  This is a build convenience only. It is never released or published, and it deliberately
  has no parent: the modules inherit from parley-parent, this does not.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>us.bringardner.parley</groupId>
  <artifactId>parley-build</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Parley build aggregator</name>
  <description>Builds the Parley modules, the widget libraries and the apps built on Parley (fsh, fsh-loupe, fsh-ide, fshdb, the viewers and the console) together. Not published.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <modules>
    <!-- Listed in dependency order (each after what it uses), for reading; Maven sorts them anyway. -->

    <!-- Widget libraries (groupId us.bringardner) -->
    <module>../swing-widgets</module>
    <module>../fx-widgets</module>

    <!-- Parent -->
    <module>../parley-parent</module>

    <!-- Logo, icons and mascot -->
    <module>../parley-brand</module>

    <!-- Core, I/O and network -->
    <module>../parley-core</module>
    <module>../parley-io</module>
    <module>../parley-net</module>
    <module>../parley-dns</module>

    <!-- Files (the file system API; the protocols below use it) -->
    <module>../parley-files</module>

    <!-- Protocols -->
    <module>../parley-ftp</module>
    <module>../parley-ssh</module>

    <!-- Mail -->
    <module>../parley-mail</module>
    <module>../parley-pop3</module>
    <module>../parley-imap</module>
    <module>../parley-smtp</module>

    <!-- File system providers -->
    <module>../parley-files-ftp</module>
    <module>../parley-files-sftp</module>
    <module>../parley-files-sftp-jsch</module>
    <module>../parley-files-sftp-mina</module>
    <module>../parley-files-sftp-parley-ssh</module>
    <module>../parley-files-jdbc</module>
    <module>../parley-credentials-keychain</module>

    <!-- File UI components -->
    <module>../parley-files-swing</module>
    <module>../parley-files-fx</module>

    <!-- Debugging: DAP and Loupe -->
    <module>../parley-dap</module>
    <module>../parley-loupe</module>

    <!-- fsh (groupId us.bringardner). It must be in this build: the viewer and the console depend
         on it, and without it Maven uses whatever fsh is in ~/.m2. -->
    <module>../fsh</module>
    <module>../fsh-loupe</module>

    <!-- Applications -->
    <module>../parley-files-viewer</module>
    <module>../parley-files-viewer-tui</module>
    <module>../fsh-ide</module>
    <module>../fshdb</module>

    <!-- The BOM lists the modules above, so it comes last -->
    <module>../parley-bom</module>
  </modules>
</project>
