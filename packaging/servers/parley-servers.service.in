[Unit]
Description=Parley @TITLE@ server (parley-@NAME@)
Documentation=https://github.com/parley-project/@MODULE@
After=network-online.target
Wants=network-online.target

[Service]
User=parley
Group=parley
WorkingDirectory=/var/lib/parley
ExecStart=/opt/parley/servers/bin/parley-@NAME@
# (a stopped JVM exits with 143, after SIGTERM)
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# (ports below 1024 without running as root)
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
